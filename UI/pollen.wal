import module.grove
import module.strings
import module.io

string: param_revision = "";
string: param_filter = "";
bool: param_writable_only = false;
long int: param_rows = 0l;
string: log_seq = "0";
long int: log_lines = 0l;
bool: typing_sent = false;
string: status_text_shown = "";
string: last_sent = "";
string: compose_now = "";
string: module_open = "";
bool: module_grid_built = false;
string: vrc_friends_rev = "";
string: vrc_coll_rev = "";
string: vrc_act_seq = "0";
long int: act_rows = 0l;
string: vrc_state_shown = "";
string: players_shown = "";
string: friends_query = "";
bool: logged_in = false;
string: fav_loaded_kind = "";

function call(const string&: name, const string&: arg) -> string;
function el(const string&: tag, const string&: cls, const string&: label) -> grove::Element;
function clear(grove::Element&: e) -> void;
