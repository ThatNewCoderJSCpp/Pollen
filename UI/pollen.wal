function update_social() -> void;

function call(const string&: name, const string&: arg) -> string {
    return grove::call("pollen." + name, arg);
} end function call

function el(const string&: tag, const string&: cls, const string&: label) -> grove::Element {
    grove::Element: e = grove::create_element(tag);
    if (!cls.empty()) then {
        e.set_attribute("class", cls);
    }
    if (!label.empty()) then {
        e.set_inner_text(label);
    }
    return e;
} end function el

function clear(grove::Element&: e) -> void {
    while (e.child_count() > 0l) {
        e.child(0l).remove();
    }
} end function clear

function tab2(const string&: a, const string&: b) -> string {
    return a + "\t" + b;
} end function tab2

function tab3(const string&: a, const string&: b, const string&: c) -> string {
    return a + "\t" + b + "\t" + c;
} end function tab3

function show(const string&: id, bool: on) -> void {
    grove::Element: e = grove::get_by_id(id);
    if (on) then {
        e.remove_class("hidden");
    } else then {
        e.add_class("hidden");
    }
} end function show

function set_text(const string&: id, const string&: msg) -> void {
    grove::get_by_id(id).set_inner_text(msg);
} end function set_text

function failed(const string&: result) -> bool {
    return result.starts_with("error");
} end function failed

function reason(const string&: result) -> string {
    auto: f = result.split("\t");
    if (f.size() > 1l) then {
        return f[1];
    }
    return result;
} end function reason

function unescape(const string&: s) -> string {
    string: out = "";
    long int: i = 0l;
    while (i < s.length()) {
        string: c = s.substr(i, 1l);
        if (c == "\\" && i + 1l < s.length()) then {
            string: n = s.substr(i + 1l, 1l);
            if (n == "n") then {
                out = out + "\n";
            } else if (n == "t") then {
                out = out + "\t";
            } else then {
                out = out + n;
            }
            i += 2l;
        } else then {
            out = out + c;
            i += 1l;
        }
    }
    return out;
} end function unescape

function touched_recently(grove::Element&: e) -> bool {
    string: t = e.get_attribute("touched");
    if (t.empty()) then {
        return false;
    }
    short float: when = std::io::parse_float<short float>(t);
    return grove::time_ms() - when < 1500.0;
} end function touched_recently

function mark_touched(grove::Element&: e) -> void {
    e.set_attribute("touched", grove::time_ms().to_string());
} end function mark_touched

function update_state() -> void {
    auto: f = call("state", "").split("\t");
    if (f.size() < 16l) then {
        return;
    }
    bool: sending = f[0] == "1";
    bool: hearing = f[1] == "1";
    grove::Element: pill = grove::get_by_id("pill");
    pill.remove_class("ok");
    pill.remove_class("waiting");
    pill.remove_class("off");
    if (!sending) then {
        pill.add_class("off");
        set_text("pill-text", "Not connected");
        set_text("conn-state", "Not connected");
    } else if (hearing) then {
        pill.add_class("ok");
        set_text("pill-text", "VRChat is talking");
        set_text("conn-state", "Connected");
    } else then {
        pill.add_class("waiting");
        if (f[3].empty()) then {
            set_text("pill-text", "Sending only");
            set_text("conn-state", "Sending only");
        } else then {
            set_text("pill-text", "Waiting for VRChat");
            set_text("conn-state", "Waiting for VRChat");
        }
    }
    set_text("pill-dot", "\u{25CF}");
    if (sending) then {
        set_text("connect", "Reconnect");
    } else then {
        set_text("connect", "Connect");
    }
    if (f[2].empty()) then {
        set_text("conn-target", "-");
    } else then {
        set_text("conn-target", f[2]);
    }
    if (f[3].empty()) then {
        set_text("conn-listen", "not listening");
    } else then {
        set_text("conn-listen", f[3]);
    }
    if (f[7] == "-1") then {
        set_text("conn-heard", "never");
    } else then {
        set_text("conn-heard", f[7] + " s ago");
    }
    set_text("st-in", f[4]);
    set_text("st-out", f[5]);
    set_text("st-err", f[6]);
    if (f[8].empty()) then {
        set_text("av-name", "No avatar yet");
    } else then {
        set_text("av-name", f[8]);
    }
    if (f[9].empty()) then {
        set_text("av-id", "-");
    } else then {
        set_text("av-id", f[9]);
    }
    set_text("av-count", f[15]);
    if (f.size() > 16l) then {
        set_text("conn-query", f[16]);
    }
    if (sending && !hearing && f.size() > 17l && f[17] == "1") then {
        set_text("pill-text", "Found VRChat");
    }
    set_text("av-live", f[14]);
    set_text("conn-error", f[12]);
    show("conn-error", !f[12].empty());
    if (f[10] != param_revision) then {
        param_revision = f[10];
        build_params();
    }
} end function update_state

function update_system() -> void {
    auto: f = call("system", "").split("\t");
    if (f.size() < 8l) then {
        return;
    }
    set_text("sys-cpu", f[0]);
    set_text("sys-ram", f[1]);
    set_text("sys-up", f[3]);
    if (f.size() > 12l) then {
        set_text("sys-gpu", f[8]);
        set_text("sys-vram", dash(f[9]));
        set_text("sys-gpu-name", dash(f[10]));
        set_text("sys-cpu-name", dash(f[11]));
        set_text("sys-mem", dash(f[12]));
        if (f.size() > 13l) then {
            set_text("sys-warning", f[13]);
            show("sys-warning", !f[13].empty());
        }
    }
    if (!f[4].empty()) then {
        if (f[5] == "playing") then {
            set_text("sys-song", "\u{25B6} " + f[4]);
        } else then {
            set_text("sys-song", "\u{23F8} " + f[4]);
        }
    } else if (!f[7].empty()) then {
        set_text("sys-song", f[7]);
    } else then {
        set_text("sys-song", "-");
    }
} end function update_system

function send_param(const string&: name, const string&: type, const string&: value) -> void {
    string: r = call("set_param", tab3(name, type, value));
    if (failed(r)) then {
        grove::log("pollen: " + reason(r));
    }
} end function send_param

function build_params() -> void {
    grove::Element: box = grove::get_by_id("param-list");
    clear(box);
    auto: rows = call("params", param_filter).split("\n");
    long int: shown = 0l;
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 6l) then {
            continue;
        }
        string: name = f[0];
        string: type = f[1];
        bool: writable = f[3] == "1";
        if (param_writable_only && !writable) then {
            continue;
        }
        string: idx = shown.to_string();
        grove::Element: row = el("row", "param", "");
        row.set_attribute("id", "prow-" + idx);
        row.set_attribute("param", name);
        grove::Element: label = el("div", "param-name", name);
        if (f[4] != "1") then {
            label.add_class("unknown");
            label.set_attribute("title", "Not in this avatar's OSC file; seen live from VRChat");
        }
        row.append_child(label);
        row.append_child(el("text", "badge " + type, type));
        grove::Element: control = el("row", "param-control", "");
        if (!writable) then {
            control.append_child(el("text", "readonly", "read only"));
        } else if (type == "bool") then {
            grove::Element: b = grove::create_element("input_bool");
            b.set_attribute("id", "pc-" + idx);
            b.set_attribute("switch", "");
            b.set_value_bool(f[2] == "true");
            b.on("change", [name](grove::Event&: e) -> void {
                grove::Element: t = e.target();
                mark_touched(t);
                if (t.value_bool()) then {
                    send_param(name, "bool", "true");
                } else then {
                    send_param(name, "bool", "false");
                }
            });
            control.append_child(b);
        } else if (type == "int") then {
            grove::Element: n = grove::create_element("input_integer");
            n.set_attribute("id", "pc-" + idx);
            n.set_attribute("class", "param-int");
            n.set_attribute("min", "0");
            n.set_attribute("max", "255");
            if (f[2].empty()) then {
                n.set_attribute("value", "0");
            } else then {
                n.set_attribute("value", f[2]);
            }
            n.on("change", [name](grove::Event&: e) -> void {
                grove::Element: t = e.target();
                mark_touched(t);
                send_param(name, "int", t.value_integer().to_string());
            });
            control.append_child(n);
        } else if (type == "float") then {
            grove::Element: s = grove::create_element("input_slider");
            s.set_attribute("id", "pc-" + idx);
            s.set_attribute("class", "param-slider");
            s.set_attribute("min", "-1");
            s.set_attribute("max", "1");
            s.set_attribute("step", "0.01");
            if (!f[2].empty()) then {
                s.set_value_float(std::io::parse_float<short float>(f[2]));
            }
            s.on("input", [name](grove::Event&: e) -> void {
                grove::Element: t = e.target();
                mark_touched(t);
                send_param(name, "float", t.value_float().to_string());
            });
            control.append_child(s);
        } else then {
            grove::Element: v = grove::create_element("input_string");
            v.set_attribute("id", "pc-" + idx);
            v.set_attribute("class", "param-int");
            v.set_attribute("placeholder", "value");
            v.on("change", [name](grove::Event&: e) -> void {
                grove::Element: t = e.target();
                mark_touched(t);
                send_param(name, "", t.value_string());
            });
            control.append_child(v);
        }
        row.append_child(control);
        grove::Element: value = el("text", "param-value", f[2]);
        value.set_attribute("id", "pv-" + idx);
        row.append_child(value);
        box.append_child(row);
        shown += 1l;
    }
    param_rows = shown;
    if (shown == 0l) then {
        if (param_filter.empty()) then {
            box.append_child(el("p", "empty", "No parameters yet. Turn OSC on in VRChat and change avatars once, and they'll show up here as VRChat sends them."));
        } else then {
            box.append_child(el("p", "empty", "Nothing matches \"" + param_filter + "\"."));
        }
        set_text("param-count", "");
    } else then {
        set_text("param-count", shown.to_string() + " shown");
    }
} end function build_params

function update_params() -> void {
    if (param_rows == 0l) then {
        return;
    }
    if (!grove::get_by_id("params").is_current()) then {
        return;
    }
    auto: rows = call("params", param_filter).split("\n");
    long int: shown = 0l;
    for (long int: i = 0l; i < rows.size() && shown < param_rows; i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 6l) then {
            continue;
        }
        if (param_writable_only && f[3] != "1") then {
            continue;
        }
        string: idx = shown.to_string();
        shown += 1l;
        grove::Element: row = grove::get_by_id("prow-" + idx);
        if (!row.exists() || row.get_attribute("param") != f[0]) then {
            build_params();
            return;
        }
        set_text("pv-" + idx, f[2]);
        grove::Element: c = grove::get_by_id("pc-" + idx);
        if (!c.exists() || f[2].empty() || touched_recently(c) || c.focused()) then {
            continue;
        }
        if (f[1] == "bool") then {
            c.set_value_bool(f[2] == "true");
        } else if (f[1] == "int") then {
            c.set_value_integer(std::io::parse_int<long int>(f[2]));
        } else if (f[1] == "float") then {
            c.set_value_float(std::io::parse_float<short float>(f[2]));
        }
    }
} end function update_params

function add_log_line(const string&: kind, const string&: seconds, const string&: msg) -> void {
    grove::Element: box = grove::get_by_id("log");
    grove::Element: row = el("row", "log-line " + kind, "");
    row.append_child(el("text", "log-time", seconds));
    string: arrow = "\u{2022}";
    if (kind == "i") then {
        arrow = "\u{2190}";
    } else if (kind == "o") then {
        arrow = "\u{2192}";
    } else if (kind == "e") then {
        arrow = "!";
    }
    row.append_child(el("text", "log-dir", arrow));
    row.append_child(el("div", "log-text", msg));
    box.append_child(row);
    log_lines += 1l;
    while (log_lines > 500l) {
        box.child(0l).remove();
        log_lines -= 1l;
    }
} end function add_log_line

function update_log() -> void {
    if (grove::get_by_id("mon-pause").value_bool()) then {
        return;
    }
    auto: rows = call("log", log_seq).split("\n");
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 4l) then {
            continue;
        }
        log_seq = f[0];
        add_log_line(f[1], f[2], f[3]);
    }
} end function update_log

function load_settings() -> void {
    auto: rows = call("settings", "").split("\n");
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 2l) then {
            continue;
        }
        string: k = f[0];
        string: v = f[1];
        if (k == "host") then {
            grove::get_by_id("set-host").set_value_string(v);
        } else if (k == "send_port") then {
            grove::get_by_id("set-send-port").set_value_integer(std::io::parse_int<long int>(v));
        } else if (k == "receive_port") then {
            grove::get_by_id("set-recv-port").set_value_integer(std::io::parse_int<long int>(v));
        } else if (k == "listen_host") then {
            grove::get_by_id("set-listen-host").set_value_string(v);
        } else if (k == "auto_connect") then {
            grove::get_by_id("set-auto").set_value_bool(v == "1");
        } else if (k == "oscquery") then {
            grove::get_by_id("set-oscquery").set_value_bool(v == "1");
        } else if (k == "status_enabled") then {
            grove::get_by_id("status-on").set_value_bool(v == "1");
        } else if (k == "status_interval") then {
            grove::get_by_id("status-interval").set_value_float(std::io::parse_float<short float>(v));
        } else if (k == "status_notify") then {
            grove::get_by_id("status-notify").set_value_bool(v == "1");
        } else if (k == "log_parameters") then {
            grove::get_by_id("mon-params").set_value_bool(v == "1");
        } else if (k == "status_template") then {
            grove::get_by_id("status-template").set_value_string(unescape(v));
        } else if (k == "osc_folder") then {
            grove::get_by_id("set-folder").set_attribute("placeholder", v);
        } else if (k == "settings_path") then {
            set_text("set-path", v);
        }
    }
} end function load_settings

function update_preview() -> void {
    string: problems = call("placeholder_problems", grove::get_by_id("status-template").value_string());
    set_text("status-problems", problems);
    show("status-problems", !problems.empty());
    string: msg = call("status_preview", "");
    if (msg != status_text_shown) then {
        status_text_shown = msg;
        if (msg.empty()) then {
            set_text("status-preview", "(nothing to send right now)");
        } else then {
            set_text("status-preview", msg);
        }
    }
} end function update_preview

function update_count(const string&: msg) -> void {
    set_text("chat-count", call("chat_length", msg) + " / 144");
} end function update_count

function set_typing(bool: on) -> void {
    if (on == typing_sent) then {
        return;
    }
    if (on && !grove::get_by_id("chat-typing").value_bool()) then {
        return;
    }
    typing_sent = on;
    if (on) then {
        call("typing", "1");
    } else then {
        call("typing", "0");
    }
} end function set_typing

function send_chat(const string&: msg) -> void {
    if (msg.trim().empty()) then {
        return;
    }
    string: notify = "0";
    if (grove::get_by_id("chat-notify").value_bool()) then {
        notify = "1";
    }
    string: r = call("chatbox", tab2(msg, notify));
    typing_sent = false;
    if (failed(r)) then {
        grove::popup_warning("Couldn't send", reason(r));
        return;
    }
    last_sent = msg;
    compose_now = "";
    grove::get_by_id("chat-text").set_value_string("");
    update_count("");
    update_bubble();
} end function send_chat

function update_bubble() -> void {
    string: source = "";
    string: shown = "";
    if (!compose_now.trim().empty()) then {
        source = "as you type";
        shown = compose_now;
    } else if (grove::get_by_id("status-on").value_bool() && !status_text_shown.empty()) then {
        source = "status message";
        shown = status_text_shown;
    } else if (!last_sent.empty()) then {
        source = "last message";
        shown = last_sent;
    }
    set_text("preview-source", source);
    show("typing-bubble", typing_sent);
    if (shown.empty()) then {
        show("bubble", false);
        show("bubble-empty", !typing_sent);
        return;
    }
    show("bubble-empty", false);
    show("bubble", true);
    set_text("bubble-text", call("chat_preview", shown));
} end function update_bubble

function dash(const string&: value) -> string {
    if (value.empty()) then {
        return "-";
    }
    return value;
} end function dash

function build_module_grid() -> void {
    grove::Element: grid = grove::get_by_id("module-grid");
    clear(grid);
    auto: rows = call("modules", "").split("\n");
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 7l) then {
            continue;
        }
        string: id = f[0];
        grove::Element: card = el("column", "module-card", "");
        card.set_attribute("id", "mc-" + id);
        grove::Element: head = el("row", "module-head", "");
        head.append_child(el("text", "module-icon", f[1]));
        head.append_child(el("text", "module-title", f[2]));
        card.append_child(head);
        card.append_child(el("div", "module-desc", f[3]));
        grove::Element: sample = el("div", "module-sample", unescape(f[4]));
        sample.set_attribute("id", "ms-" + id);
        card.append_child(sample);
        string: count = f[5] + " of " + f[6] + " placeholders on";
        if (f[6] == "0") then {
            count = "applies to every module";
        }
        grove::Element: n = el("div", "module-count", count);
        n.set_attribute("id", "mn-" + id);
        card.append_child(n);
        card.on("click", [id](grove::Event&: e) -> void {
            open_module(id);
        });
        grid.append_child(card);
    }
    module_grid_built = true;
} end function build_module_grid

function update_module_grid() -> void {
    if (!module_grid_built) then {
        build_module_grid();
        return;
    }
    auto: rows = call("modules", "").split("\n");
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 7l) then {
            continue;
        }
        set_text("ms-" + f[0], unescape(f[4]));
        if (f[6] != "0") then {
            set_text("mn-" + f[0], f[5] + " of " + f[6] + " placeholders on");
        }
    }
} end function update_module_grid

function open_module(const string&: id) -> void {
    module_open = id;
    auto: t = call("module_title", id).split("\t");
    if (t.size() >= 3l) then {
        set_text("mm-icon", t[0]);
        set_text("mm-title", t[1]);
        set_text("mm-desc", t[2]);
    }
    grove::get_by_id("mm-template").set_value_string(unescape(call("module_template", id)));
    set_text("mm-note", "");
    build_module_options();
    update_module_chips();
    update_module_preview();
    grove::get_by_id("module-modal").open_modal();
} end function open_module

function build_module_options() -> void {
    grove::Element: box = grove::get_by_id("mm-options");
    clear(box);
    auto: rows = call("module_options", module_open).split("\n");
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 8l) then {
            continue;
        }
        string: kind = f[0];
        string: option = f[1];
        if (kind == "bool") then {
            grove::Element: b = grove::create_element("input_bool");
            b.set_attribute("switch", "");
            b.set_inner_text(f[2]);
            b.set_value_bool(f[3] == "1");
            b.on("change", [option](grove::Event&: e) -> void {
                if (e.target().value_bool()) then {
                    option_changed(option, "1");
                } else then {
                    option_changed(option, "0");
                }
            });
            box.append_child(b);
        } else then {
            grove::Element: row = el("row", "mm-option", "");
            row.append_child(el("text", "mm-label", f[2]));
            if (kind == "choice") then {
                grove::Element: sel = grove::create_element("input_select");
                sel.set_attribute("class", "mm-input");
                auto: choices = f[5].split("|");
                for (long int: c = 0l; c < choices.size(); c += 1l) {
                    auto: pair = choices[c].split("=");
                    if (pair.size() < 2l) then {
                        continue;
                    }
                    grove::Element: o = grove::create_element("option");
                    o.set_attribute("value", pair[0]);
                    o.set_inner_text(pair[1]);
                    sel.append_child(o);
                }
                sel.set_attribute("value", f[3]);
                sel.on("change", [option](grove::Event&: e) -> void {
                    option_changed(option, e.target().value_string());
                });
                row.append_child(sel);
            } else if (kind == "integer") then {
                grove::Element: n = grove::create_element("input_integer");
                n.set_attribute("class", "mm-input");
                n.set_attribute("value", f[3]);
                n.on("change", [option](grove::Event&: e) -> void {
                    option_changed(option, e.target().value_integer().to_string());
                });
                row.append_child(n);
            } else if (kind == "float") then {
                grove::Element: n = grove::create_element("input_string");
                n.set_attribute("class", "mm-input");
                n.set_attribute("allow", "digits");
                n.set_attribute("chars", ".-");
                n.set_value_string(f[3]);
                n.on("change", [option](grove::Event&: e) -> void {
                    option_changed(option, e.target().value_string());
                });
                row.append_child(n);
            } else then {
                grove::Element: t = grove::create_element("input_string");
                t.set_attribute("class", "mm-input");
                t.set_value_string(f[3]);
                t.on("change", [option](grove::Event&: e) -> void {
                    option_changed(option, e.target().value_string());
                });
                row.append_child(t);
            }
            box.append_child(row);
        }
        if (!f[4].empty()) then {
            box.append_child(el("div", "mm-hint", f[4]));
        }
    }
} end function build_module_options

function option_changed(const string&: option, const string&: value) -> void {
    string: r = call("module_set", tab3(module_open, option, value));
    if (failed(r)) then {
        set_text("mm-note", reason(r));
    } else then {
        set_text("mm-note", "");
    }
    build_module_options();
    update_module_chips();
    update_module_preview();
    update_module_grid();
    fill_status_chips();
} end function option_changed

function placeholder_row(const string&: name, const string&: desc) -> grove::Element {
    grove::Element: row = el("column", "ph-row", "");
    grove::Element: head = el("row", "ph-head", "");
    grove::Element: holder = el("row", "ph-chip", "");
    grove::Element: chip = el("text", "chip", name);
    chip.set_attribute("title", "Click to add " + name);
    holder.append_child(chip);
    head.append_child(holder);
    head.append_child(el("div", "ph-desc", desc));
    row.append_child(head);
    return row;
} end function placeholder_row

function add_placeholder_settings(grove::Element&: row, const string&: name) -> void {
    auto: rows = call("placeholder_options", tab2(module_open, name)).split("\n");
    grove::Element: box = el("row", "ph-settings", "");
    long int: count = 0l;
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 6l) then {
            continue;
        }
        string: setting = f[1];
        if (f[0] == "bool") then {
            grove::Element: b = grove::create_element("input_bool");
            b.set_attribute("switch", "");
            b.set_inner_text(f[2]);
            if (!f[4].empty()) then {
                b.set_attribute("title", f[4]);
            }
            b.set_value_bool(f[3] == "1");
            b.on("change", [name, setting](grove::Event&: e) -> void {
                if (e.target().value_bool()) then {
                    placeholder_changed(name, setting, "1");
                } else then {
                    placeholder_changed(name, setting, "0");
                }
            });
            box.append_child(b);
        } else then {
            grove::Element: pair = el("row", "ph-setting", "");
            pair.append_child(el("text", "ph-label", f[2]));
            grove::Element: sel = grove::create_element("input_select");
            sel.set_attribute("class", "ph-select");
            auto: choices = f[5].split("|");
            for (long int: c = 0l; c < choices.size(); c += 1l) {
                auto: kv = choices[c].split("=");
                if (kv.size() < 2l) then {
                    continue;
                }
                grove::Element: o = grove::create_element("option");
                o.set_attribute("value", kv[0]);
                o.set_inner_text(kv[1]);
                sel.append_child(o);
            }
            sel.set_attribute("value", f[3]);
            sel.on("change", [name, setting](grove::Event&: e) -> void {
                placeholder_changed(name, setting, e.target().value_string());
            });
            pair.append_child(sel);
            box.append_child(pair);
        }
        count += 1l;
    }
    if (count > 0l) then {
        row.append_child(box);
    }
} end function add_placeholder_settings

function placeholder_changed(const string&: name, const string&: setting, const string&: value) -> void {
    string: r = call("placeholder_set", tab2(module_open, tab3(name, setting, value)));
    if (failed(r)) then {
        set_text("mm-note", reason(r));
    } else then {
        set_text("mm-note", "");
    }
    update_module_chips();
    update_module_preview();
    update_module_grid();
} end function placeholder_changed

function update_module_chips() -> void {
    grove::Element: box = grove::get_by_id("mm-chips");
    clear(box);
    auto: rows = call("module_placeholders", module_open).split("\n");
    long int: shown = 0l;
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 4l) then {
            continue;
        }
        string: name = f[0];
        bool: on = f[2] == "1";
        string: need = f[3];
        grove::Element: row = placeholder_row("{" + name + "}", f[1]);
        grove::Element: chip = row.child(0l).child(0l).child(0l);
        if (!on) then {
            row.add_class("off");
            chip.add_class("off");
            chip.set_attribute("title", need + " to use this");
            row.append_child(el("div", "ph-need", need + " to use this"));
        }
        add_placeholder_settings(row, name);
        if (f.size() > 4l && !f[4].empty()) then {
            add_examples(row, f[4]);
        }
        chip.on("click", [name, on, need](grove::Event&: e) -> void {
            if (on) then {
                insert_module_placeholder(name);
            } else then {
                set_text("mm-note", need + " to use {" + name + "}");
            }
        });
        box.append_child(row);
        shown += 1l;
    }
    if (shown == 0l) then {
        box.append_child(el("div", "ph-row ph-desc", "This module has no placeholders of its own; its options change how every other module writes its values."));
    }
} end function update_module_chips

function add_examples(grove::Element&: row, const string&: examples) -> void {
    grove::Element: box = el("row", "ph-examples", "");
    box.append_child(el("text", "ph-label", "Just here:"));
    auto: list = examples.split("|");
    for (long int: i = 0l; i < list.size(); i += 1l) {
        string: snippet = list[i];
        if (snippet.empty()) then {
            continue;
        }
        grove::Element: chip = el("text", "chip small-chip", snippet);
        chip.set_attribute("title", "Click to add " + snippet + ", which changes only this one spot");
        chip.on("click", [snippet](grove::Event&: e) -> void {
            insert_module_text(snippet);
        });
        box.append_child(chip);
    }
    row.append_child(box);
} end function add_examples

function insert_module_text(const string&: snippet) -> void {
    grove::Element: t = grove::get_by_id("mm-template");
    string: value = t.value_string() + snippet;
    t.set_value_string(value);
    call("module_template_set", tab2(module_open, value));
    update_module_preview();
} end function insert_module_text

function insert_module_placeholder(const string&: name) -> void {
    grove::Element: t = grove::get_by_id("mm-template");
    string: value = t.value_string() + "{" + name + "}";
    t.set_value_string(value);
    call("module_template_set", tab2(module_open, value));
    update_module_preview();
} end function insert_module_placeholder

function update_module_preview() -> void {
    if (module_open.empty()) then {
        return;
    }
    string: tpl = grove::get_by_id("mm-template").value_string();
    string: out = call("module_preview", tab2(module_open, tpl));
    if (out.empty()) then {
        set_text("mm-preview", "(nothing to show right now)");
    } else then {
        set_text("mm-preview", out);
    }
    set_text("mm-status", call("module_status", module_open));
    string: warning = call("module_warning", module_open);
    string: problems = call("placeholder_problems", tpl);
    if (!problems.empty()) then {
        if (warning.empty()) then {
            warning = problems;
        } else then {
            warning = problems + "\n" + warning;
        }
    }
    set_text("mm-warning", warning);
    show("mm-warning", !warning.empty());
} end function update_module_preview

function fill_status_chips() -> void {
    grove::Element: box = grove::get_by_id("placeholders");
    clear(box);
    auto: rows = call("placeholders", "").split("\n");
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f[0].empty()) then {
            continue;
        }
        string: name = f[0];
        string: desc = "";
        if (f.size() > 1l) then {
            desc = f[1];
        }
        grove::Element: row = placeholder_row(name, desc);
        row.child(0l).child(0l).child(0l).on("click", [name](grove::Event&: e) -> void {
            insert_status_placeholder(name);
        });
        box.append_child(row);
    }
} end function fill_status_chips

function insert_status_placeholder(const string&: name) -> void {
    grove::Element: t = grove::get_by_id("status-template");
    string: value = t.value_string() + name;
    t.set_value_string(value);
    call("set", tab2("status_template", value));
    update_preview();
} end function insert_status_placeholder

function fill_folders() -> void {
    grove::Element: box = grove::get_by_id("folders");
    clear(box);
    auto: rows = call("folders", "").split("\n");
    long int: n = 0l;
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        if (rows[i].empty()) then {
            continue;
        }
        box.append_child(el("text", "", rows[i]));
        n += 1l;
    }
    if (n == 0l) then {
        box.append_child(el("text", "muted", "None yet. VRChat makes its OSC folder the first time OSC is turned on."));
    }
} end function fill_folders

grove::get_by_id("connect").on("click", [](grove::Event&: e) -> void {
    string: r = call("connect", "");
    if (failed(r)) then {
        grove::popup_warning("Couldn't connect", reason(r));
    }
    update_state();
});

grove::get_by_id("disconnect").on("click", [](grove::Event&: e) -> void {
    call("disconnect", "");
    update_state();
});

grove::get_by_id("av-reload").on("click", [](grove::Event&: e) -> void {
    string: r = call("reload_avatar", "");
    if (failed(r)) then {
        grove::popup_info("Avatar", reason(r));
    }
    update_state();
});

grove::get_by_id("param-filter").on("key_down", [](grove::Event&: e) -> void {
    param_filter = e.target().value_string();
    build_params();
});

grove::get_by_id("param-filter").on("change", [](grove::Event&: e) -> void {
    param_filter = e.target().value_string();
    build_params();
});

grove::get_by_id("param-writable").on("change", [](grove::Event&: e) -> void {
    param_writable_only = e.target().value_bool();
    build_params();
});

grove::get_by_id("custom-send").on("click", [](grove::Event&: e) -> void {
    string: name = grove::get_by_id("custom-name").value_string().trim();
    string: type = grove::get_by_id("custom-type").value_string();
    string: value = grove::get_by_id("custom-value").value_string();
    string: r = call("set_param", tab3(name, type, value));
    if (failed(r)) then {
        grove::popup_warning("Couldn't set it", reason(r));
    }
});

grove::get_by_id("chat-text").on("key_down", [](grove::Event&: e) -> void {
    string: msg = e.target().value_string();
    if (e.key() == "Enter") then {
        send_chat(msg);
        e.prevent_default();
        return;
    }
    if (e.key() == "Escape") then {
        compose_now = "";
    } else if (e.key() == "Backspace") then {
        compose_now = call("chat_drop_last", msg);
    } else then {
        compose_now = msg;
    }
    update_count(msg);
    set_typing(true);
    update_bubble();
});

grove::get_by_id("chat-text").on("text", [](grove::Event&: e) -> void {
    compose_now = e.target().value_string() + e.input_text();
    update_count(compose_now);
    update_bubble();
});

grove::get_by_id("chat-text").on("blur", [](grove::Event&: e) -> void {
    set_typing(false);
    compose_now = e.target().value_string();
    update_bubble();
});

grove::get_by_id("chat-send").on("click", [](grove::Event&: e) -> void {
    send_chat(grove::get_by_id("chat-text").value_string());
});

grove::get_by_id("chat-clear").on("click", [](grove::Event&: e) -> void {
    call("chatbox", tab2("", "0"));
    typing_sent = false;
    last_sent = "";
    update_bubble();
});

grove::get_by_id("status-on").on("change", [](grove::Event&: e) -> void {
    if (e.target().value_bool()) then {
        call("set", tab2("status_enabled", "1"));
    } else then {
        call("set", tab2("status_enabled", "0"));
    }
    update_bubble();
});

grove::get_by_id("status-template").on("change", [](grove::Event&: e) -> void {
    call("set", tab2("status_template", e.target().value_string()));
    update_preview();
});

grove::get_by_id("status-template").on("input", [](grove::Event&: e) -> void {
    call("set", tab2("status_template", e.target().value_string()));
    update_preview();
});

grove::get_by_id("status-interval").on("change", [](grove::Event&: e) -> void {
    string: r = call("set", tab2("status_interval", e.target().value_float().to_string()));
    if (failed(r)) then {
        grove::popup_warning("Status interval", reason(r));
        load_settings();
    }
});

grove::get_by_id("status-notify").on("change", [](grove::Event&: e) -> void {
    if (e.target().value_bool()) then {
        call("set", tab2("status_notify", "1"));
    } else then {
        call("set", tab2("status_notify", "0"));
    }
});

grove::get_by_id("status-rotate-block").on("click", [](grove::Event&: e) -> void {
    grove::Element: t = grove::get_by_id("status-template");
    string: value = t.value_string();
    if (!value.empty() && !value.ends_with("\n")) then {
        value = value + "\n";
    }
    value = value + "[rotate]\nCPU {cpu} \u{00B7} {cpu_temp}\nGPU {gpu} \u{00B7} {gpu_temp}\nRAM {ram_used} / {ram_total}\n[/rotate]";
    t.set_value_string(value);
    call("set", tab2("status_template", value));
    update_preview();
});

grove::get_by_id("status-rotate-inline").on("click", [](grove::Event&: e) -> void {
    grove::Element: t = grove::get_by_id("status-template");
    string: value = t.value_string() + "[[CPU {cpu} || GPU {gpu} || RAM {ram}]]";
    t.set_value_string(value);
    call("set", tab2("status_template", value));
    update_preview();
});

grove::get_by_id("status-send").on("click", [](grove::Event&: e) -> void {
    string: r = call("status_send", "");
    if (failed(r)) then {
        grove::popup_warning("Couldn't send", reason(r));
    }
});

grove::get_by_id("mon-params").on("change", [](grove::Event&: e) -> void {
    if (e.target().value_bool()) then {
        call("set", tab2("log_parameters", "1"));
    } else then {
        call("set", tab2("log_parameters", "0"));
    }
});

grove::get_by_id("mon-clear").on("click", [](grove::Event&: e) -> void {
    call("log_clear", "");
    grove::Element: box = grove::get_by_id("log");
    clear(box);
    log_lines = 0l;
});

grove::get_by_id("raw-send").on("click", [](grove::Event&: e) -> void {
    string: r = call("send", grove::get_by_id("raw").value_string());
    set_text("raw-error", reason(r));
    show("raw-error", failed(r));
});

grove::get_by_id("raw").on("key_down", [](grove::Event&: e) -> void {
    if (e.key() == "Enter") then {
        string: r = call("send", e.target().value_string());
        set_text("raw-error", reason(r));
        show("raw-error", failed(r));
    }
});

grove::get_by_id("set-apply").on("click", [](grove::Event&: e) -> void {
    string: r = call("set", tab2("host", grove::get_by_id("set-host").value_string().trim()));
    if (!failed(r)) then {
        r = call("set", tab2("send_port", grove::get_by_id("set-send-port").value_integer().to_string()));
    }
    if (!failed(r)) then {
        r = call("set", tab2("receive_port", grove::get_by_id("set-recv-port").value_integer().to_string()));
    }
    if (!failed(r)) then {
        r = call("set", tab2("listen_host", grove::get_by_id("set-listen-host").value_string().trim()));
    }
    if (!failed(r)) then {
        if (grove::get_by_id("set-oscquery").value_bool()) then {
            r = call("set", tab2("oscquery", "1"));
        } else then {
            r = call("set", tab2("oscquery", "0"));
        }
    }
    if (!failed(r)) then {
        if (grove::get_by_id("set-auto").value_bool()) then {
            r = call("set", tab2("auto_connect", "1"));
        } else then {
            r = call("set", tab2("auto_connect", "0"));
        }
    }
    if (failed(r)) then {
        set_text("set-result", reason(r));
        return;
    }
    r = call("connect", "");
    if (failed(r)) then {
        set_text("set-result", "Saved, but " + reason(r));
    } else then {
        set_text("set-result", "Saved and connected");
    }
    update_state();
});

grove::get_by_id("set-folder").on("change", [](grove::Event&: e) -> void {
    call("set", tab2("osc_folder", e.target().value_string()));
    call("reload_avatar", "");
    fill_folders();
});

grove::get_by_id("set-folder-clear").on("click", [](grove::Event&: e) -> void {
    call("set", tab2("osc_folder", ""));
    grove::get_by_id("set-folder").set_value_string("");
    fill_folders();
});

grove::get_by_id("settings").on("page_show", [](grove::Event&: e) -> void {
    fill_folders();
});

fill_status_chips();

grove::get_by_id("mm-template").on("input", [](grove::Event&: e) -> void {
    call("module_template_set", tab2(module_open, e.target().value_string()));
    update_module_preview();
});

grove::get_by_id("mm-template").on("change", [](grove::Event&: e) -> void {
    call("module_template_set", tab2(module_open, e.target().value_string()));
    update_module_preview();
});

grove::get_by_id("mm-add").on("click", [](grove::Event&: e) -> void {
    string: tpl = grove::get_by_id("mm-template").value_string();
    if (tpl.trim().empty()) then {
        set_text("mm-note", "Write something to add first");
        return;
    }
    string: r = call("status_append", tpl);
    if (failed(r)) then {
        set_text("mm-note", reason(r));
        return;
    }
    grove::get_by_id("status-template").set_value_string(unescape(r));
    set_text("mm-note", "Added to the end of your status message");
    update_preview();
});

grove::get_by_id("module-modal").on("close", [](grove::Event&: e) -> void {
    module_open = "";
    update_module_grid();
});

grove::get_by_id("modules").on("page_show", [](grove::Event&: e) -> void {
    update_module_grid();
});

grove::get_by_id("chat").on("page_show", [](grove::Event&: e) -> void {
    fill_status_chips();
});

grove::set_interval(1000.0, []() -> void {
    if (!module_open.empty()) then {
        update_module_preview();
    }
    if (grove::get_by_id("modules").is_current()) then {
        update_module_grid();
    }
});

grove::set_interval(200.0, []() -> void {
    update_state();
    update_params();
    update_log();
});

grove::set_interval(1000.0, []() -> void {
    update_system();
    if (grove::get_by_id("chat").is_current()) then {
        update_preview();
        update_bubble();
    }
});

set_text("version", "v" + call("version", ""));
load_settings();
update_state();
update_system();
update_preview();
update_bubble();
fill_folders();
build_params();


function status_class(const string&: status) -> string {
    if (status == "join me") then {
        return "s-join";
    } else if (status == "active") then {
        return "s-active";
    } else if (status == "ask me") then {
        return "s-ask";
    } else if (status == "busy") then {
        return "s-busy";
    }
    return "s-offline";
} end function status_class

function activity_flags() -> string {
    string: out = "";
    auto: ids = "f-friends|f-joins|f-online|f-moves|f-status".split("|");
    for (long int: i = 0l; i < ids.size(); i += 1l) {
        if (grove::get_by_id(ids[i]).value_bool()) then {
            out = out + "1";
        } else then {
            out = out + "0";
        }
    }
    return out;
} end function activity_flags

function update_account() -> void {
    auto: f = call("vrc_account", "").split("\t");
    if (f.size() < 14l) then {
        return;
    }
    string: state = f[0];
    logged_in = state == "loggedin";
    show("vrc-login-box", state == "loggedout" || state == "working");
    show("vrc-code-box", state == "code");
    show("vrc-approve-box", state == "approve");
    show("vrc-out-box", state == "loggedin");
    show("social-login", !logged_in);
    if (state == "loggedin") then {
        set_text("vrc-state", "Logged in as " + f[5]);
    } else if (state == "working") then {
        set_text("vrc-state", "Working...");
    } else if (state == "code") then {
        if (f[2] == "email") then {
            set_text("vrc-state", "Check your email");
        } else then {
            set_text("vrc-state", "Two-factor code");
        }
    } else if (state == "approve") then {
        set_text("vrc-state", "Approve this login on vrchat.com");
    } else then {
        set_text("vrc-state", "Not logged in");
    }
    set_text("vrc-message", f[1]);
    set_text("vrc-device-code", f[3]);
    grove::Element: dot = grove::get_by_id("me-dot");
    dot.set_attribute("class", "status-dot " + status_class(f[6]));
    if (logged_in) then {
        set_text("me-name", f[5]);
        if (f[8].empty()) then {
            set_text("me-status", f[7]);
        } else then {
            set_text("me-status", f[7] + " \u{00B7} " + f[8]);
        }
        if (f[9] == "1") then {
            set_text("me-live", "connected");
        } else then {
            set_text("me-live", "connecting...");
        }
    } else then {
        dot.set_attribute("class", "status-dot s-offline");
        set_text("me-name", "Not logged in");
        set_text("me-status", "");
        set_text("me-live", "-");
        set_text("me-online", "-");
        set_text("me-web", "-");
    }
    set_text("me-note", f[10]);
    set_text("fav-note", f[10]);
    if (f[11] != vrc_friends_rev) then {
        vrc_friends_rev = f[11];
        if (grove::get_by_id("social").is_current()) then {
            build_friends();
        }
    }
    if (!logged_in) then {
        fav_loaded_kind = "";
    } else if (grove::get_by_id("favorites").is_current() && fav_loaded_kind != grove::get_by_id("fav-kind").value_string()) then {
        load_favorites();
    }
    if (f[12] != vrc_coll_rev) then {
        vrc_coll_rev = f[12];
        if (grove::get_by_id("favorites").is_current()) then {
            build_favorites();
        }
    }
    if (f[13] != vrc_act_seq && grove::get_by_id("social").is_current()) then {
        update_activity(false);
    }
} end function update_account

function update_world() -> void {
    auto: rows = call("vrc_world", "").split("\n");
    string: found = "0";
    string: in_world = "0";
    string: file = "";
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 2l) then {
            continue;
        }
        string: k = f[0];
        string: v = f[1];
        if (k == "found") then {
            found = v;
        } else if (k == "file") then {
            file = v;
        } else if (k == "in_world") then {
            in_world = v;
        } else if (k == "world") then {
            if (v.empty()) then {
                set_text("w-name", "Not in a world");
            } else then {
                set_text("w-name", v);
            }
        } else if (k == "type") then {
            set_text("w-type", dash(v));
        } else if (k == "region") then {
            set_text("w-region", dash(v));
        } else if (k == "instance") then {
            set_text("w-instance", dash(v));
        } else if (k == "players") then {
            set_text("w-players", v);
        } else if (k == "since") then {
            set_text("w-since", dash(v));
        }
    }
    if (in_world != "1") then {
        set_text("w-name", "Not in a world");
    }
    if (found != "1") then {
        set_text("w-note", "Pollen hasn't found VRChat's log yet. It looks next to VRChat's OSC folder; set that folder in Settings if VRChat is somewhere unusual.");
    } else then {
        set_text("w-note", "Reading " + file);
    }
} end function update_world

function build_players() -> void {
    string: listing = call("vrc_players", "");
    if (listing == players_shown) then {
        return;
    }
    players_shown = listing;
    grove::Element: box = grove::get_by_id("players");
    clear(box);
    auto: rows = listing.split("\n");
    long int: n = 0l;
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 4l) then {
            continue;
        }
        grove::Element: row = el("row", "person", "");
        grove::Element: main = el("column", "person-main", "");
        grove::Element: name = el("div", "person-name", f[0]);
        if (f[2] == "1") then {
            name.add_class("friend");
        }
        main.append_child(name);
        if (f[2] == "1") then {
            main.append_child(el("div", "person-sub", "Friend \u{00B7} here since " + f[3]));
        } else then {
            main.append_child(el("div", "person-sub", "Here since " + f[3]));
        }
        row.append_child(main);
        box.append_child(row);
        n += 1l;
    }
    if (n == 0l) then {
        box.append_child(el("div", "empty-small", "Nobody yet. People show up here as VRChat logs them joining."));
    }
} end function build_players

function update_activity(bool: reset) -> void {
    grove::Element: box = grove::get_by_id("activity");
    if (reset) then {
        clear(box);
        act_rows = 0l;
        vrc_act_seq = "0";
    }
    auto: rows = call("vrc_activity", tab2(vrc_act_seq, activity_flags())).split("\n");
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 5l) then {
            continue;
        }
        vrc_act_seq = f[0];
        if (f[3] != "1") then {
            continue;
        }
        string: kind = f[2];
        string: cls = "act-line";
        if (kind == "removed") then {
            cls = "act-line removed";
        } else if (kind == "world") then {
            cls = "act-line world";
        } else if (kind != "join" && kind != "leave" && kind != "you") then {
            cls = "act-line friend";
        } else if (f[4].starts_with("Your friend")) then {
            cls = "act-line friend";
        }
        if (act_rows == 0l) then {
            clear(box);
        }
        grove::Element: line = el("row", cls, "");
        line.append_child(el("text", "act-time", f[1]));
        line.append_child(el("div", "act-text", f[4]));
        box.append_child(line);
        act_rows += 1l;
        while (act_rows > 300l) {
            box.child(0l).remove();
            act_rows -= 1l;
        }
    }
    if (act_rows == 0l && box.child_count() == 0l) then {
        box.append_child(el("div", "empty-small", "Nothing yet. Joins, leaves and friend news show up here as they happen."));
    }
} end function update_activity

function act_button(const string&: label, const string&: action, const string&: id, const string&: name) -> grove::Element {
    grove::Element: b = el("button", "ghost small", label);
    b.on("click", [action, id, name](grove::Event&: e) -> void {
        friend_action(action, id, name);
    });
    return b;
} end function act_button

function confirm_act(const string&: title, const string&: message, const string&: args) -> void {
    grove::confirm(title, message, [args](bool: yes) -> void {
        if (yes) then {
            call("vrc_act", args);
        }
    });
} end function confirm_act

function friend_action(const string&: action, const string&: id, const string&: name) -> void {
    if (action == "unfriend") then {
        confirm_act("Unfriend " + name, "Remove " + name + " from your VRChat friends? They won't be told, but you'll have to send a new friend request to undo it.", tab2("unfriend", id));
        return;
    }
    call("vrc_act", tab2(action, id));
} end function friend_action

function build_friends() -> void {
    grove::Element: box = grove::get_by_id("friend-list");
    clear(box);
    string: filter = grove::get_by_id("fr-filter").value_string();
    auto: rows = call("vrc_friends", tab2(filter, friends_query)).split("\n");
    long int: shown = 0l;
    long int: online = 0l;
    long int: web = 0l;
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 8l) then {
            continue;
        }
        string: id = f[0];
        string: name = f[1];
        string: rank = f[2];
        if (rank == "0" || rank == "1") then {
            online += 1l;
        } else if (rank == "2") then {
            web += 1l;
        }
        if (shown >= 300l) then {
            continue;
        }
        grove::Element: row = el("row", "person", "");
        grove::Element: dot = el("text", "person-dot " + status_class(f[3]), "\u{25CF}");
        row.append_child(dot);
        grove::Element: main = el("column", "person-main", "");
        string: title = name + "  \u{00B7}  " + f[4];
        if (!f[5].empty()) then {
            title = title + " \u{00B7} " + f[5];
        }
        main.append_child(el("div", "person-name", title));
        string: sub = f[6];
        if (!f[7].empty()) then {
            sub = sub + " (" + f[7] + ")";
        }
        main.append_child(el("div", "person-sub", sub));
        row.append_child(main);
        grove::Element: actions = el("row", "person-actions", "");
        if (rank == "1") then {
            actions.append_child(act_button("Request invite", "request-invite", id, name));
            actions.append_child(act_button("Invite here", "invite", id, name));
        }
        actions.append_child(act_button("Favorite", "fav-add-friend", id, name));
        actions.append_child(act_button("Unfriend", "unfriend", id, name));
        row.append_child(actions);
        box.append_child(row);
        shown += 1l;
    }
    if (logged_in) then {
        set_text("me-online", online.to_string());
        set_text("me-web", web.to_string());
    }
    if (shown == 0l) then {
        if (logged_in) then {
            box.append_child(el("div", "empty-small", "No friends match."));
        } else then {
            box.append_child(el("div", "empty-small", "Log in to VRChat under Settings to see your friends."));
        }
    }
} end function build_friends

function fav_row(const string&: kind, const string&: line, const string&: groups) -> grove::Element {
    auto: f = line.split("\t");
    string: id = f[0];
    string: target = f[1];
    string: name = f[2];
    grove::Element: row = el("row", "fav-row", "");
    if (f[6] == "1") then {
        row.add_class("archived");
    }
    grove::Element: main = el("column", "fav-main", "");
    main.append_child(el("div", "fav-name", name));
    if (!f[3].empty()) then {
        main.append_child(el("div", "fav-detail", f[3]));
    }
    row.append_child(main);
    if (kind == "avatars" || kind == "worlds" || kind == "friends") then {
        row.append_child(el("text", "fav-group", f[4]));
        grove::Element: sel = grove::create_element("input_select");
        sel.set_attribute("class", "fav-move");
        grove::Element: first = grove::create_element("option");
        first.set_attribute("value", "");
        first.set_inner_text("Move to another group...");
        sel.append_child(first);
        auto: choices = groups.split("|");
        for (long int: c = 0l; c < choices.size(); c += 1l) {
            auto: kv = choices[c].split("=");
            if (kv.size() < 2l || kv[0] == f[5]) then {
                continue;
            }
            grove::Element: o = grove::create_element("option");
            o.set_attribute("value", kv[0]);
            o.set_inner_text("Move to " + kv[1]);
            sel.append_child(o);
        }
        sel.set_attribute("value", "");
        sel.on("change", [kind, id, target](grove::Event&: e) -> void {
            string: to = e.target().value_string();
            if (!to.empty()) then {
                call("vrc_act", tab2("fav-move", tab2(kind, tab3(id, target, to))));
            }
        });
        row.append_child(sel);
        grove::Element: remove = el("button", "ghost small", "Remove");
        remove.on("click", [kind, id, name](grove::Event&: e) -> void {
            confirm_act("Remove favorite", "Remove " + name + " from your favorites?", tab3("fav-remove", id, kind));
        });
        row.append_child(remove);
    } else if (f[7] == "1") then {
        grove::Element: del = el("button", "ghost small", "Delete upload");
        del.on("click", [kind, id, name](grove::Event&: e) -> void {
            confirm_act("Delete " + name, "Delete your uploaded " + name + "? This can't be undone.", tab3("file-delete", id, kind));
        });
        row.append_child(del);
    } else then {
        string: archived = f[6];
        string: label = "Archive";
        string: to = "1";
        if (archived == "1") then {
            label = "Unarchive";
            to = "0";
        }
        grove::Element: arch = el("button", "ghost small", label);
        arch.on("click", [kind, id, to](grove::Event&: e) -> void {
            call("vrc_act", tab2("inv-archive", tab3(id, to, kind)));
        });
        row.append_child(arch);
        grove::Element: del = el("button", "ghost small", "Delete");
        del.on("click", [kind, id, name](grove::Event&: e) -> void {
            confirm_act("Delete " + name, "Delete " + name + " from your inventory? VRChat may not give it back.", tab3("inv-delete", id, kind));
        });
        row.append_child(del);
    }
    return row;
} end function fav_row

function build_favorites() -> void {
    grove::Element: box = grove::get_by_id("fav-list");
    clear(box);
    string: kind = grove::get_by_id("fav-kind").value_string();
    string: fav_type = "friend";
    if (kind == "avatars") then {
        fav_type = "avatar";
    } else if (kind == "worlds") then {
        fav_type = "world";
    }
    string: groups = call("vrc_groups", fav_type);
    string: archived = "0";
    if (grove::get_by_id("fav-archived").value_bool()) then {
        archived = "1";
    }
    auto: rows = call("vrc_collection", tab3(kind, grove::get_by_id("fav-filter").value_string(), archived)).split("\n");
    long int: shown = 0l;
    for (long int: i = 0l; i < rows.size(); i += 1l) {
        auto: f = rows[i].split("\t");
        if (f.size() < 8l) then {
            continue;
        }
        box.append_child(fav_row(kind, rows[i], groups));
        shown += 1l;
    }
    set_text("fav-status", call("vrc_collection_status", kind));
    if (shown == 0l) then {
        if (!logged_in) then {
            box.append_child(el("p", "empty", "Log in to VRChat under Settings to manage your favorites and inventory."));
        } else then {
            box.append_child(el("p", "empty", "Nothing here. Press Reload if you just changed something in VRChat."));
        }
    }
} end function build_favorites

function load_favorites() -> void {
    if (!logged_in) then {
        build_favorites();
        return;
    }
    fav_loaded_kind = grove::get_by_id("fav-kind").value_string();
    call("vrc_load", fav_loaded_kind);
    set_text("fav-status", "Loading...");
} end function load_favorites

function update_social() -> void {
    update_world();
    build_players();
} end function update_social

grove::get_by_id("vrc-login").on("click", [](grove::Event&: e) -> void {
    string: r = call("vrc_login", tab2(grove::get_by_id("vrc-user").value_string().trim(), grove::get_by_id("vrc-pass").value_string()));
    grove::get_by_id("vrc-pass").set_value_string("");
    if (failed(r)) then {
        set_text("vrc-message", reason(r));
    }
    update_account();
});

grove::get_by_id("vrc-code-login").on("click", [](grove::Event&: e) -> void {
    call("vrc_login_code", "");
    update_account();
});

grove::get_by_id("vrc-verify").on("click", [](grove::Event&: e) -> void {
    call("vrc_verify", grove::get_by_id("vrc-code").value_string());
    grove::get_by_id("vrc-code").set_value_string("");
    update_account();
});

grove::get_by_id("vrc-code").on("key_down", [](grove::Event&: e) -> void {
    if (e.key() == "Enter") then {
        call("vrc_verify", e.target().value_string());
        e.target().set_value_string("");
        update_account();
    }
});

grove::get_by_id("vrc-cancel-code").on("click", [](grove::Event&: e) -> void {
    call("vrc_cancel", "");
    update_account();
});

grove::get_by_id("vrc-cancel-approve").on("click", [](grove::Event&: e) -> void {
    call("vrc_cancel", "");
    update_account();
});

grove::get_by_id("vrc-open").on("click", [](grove::Event&: e) -> void {
    string: r = call("vrc_open_login", "");
    if (failed(r)) then {
        set_text("vrc-message", reason(r));
    }
});

grove::get_by_id("vrc-copy").on("click", [](grove::Event&: e) -> void {
    string: r = call("vrc_copy_login", "");
    if (failed(r)) then {
        set_text("vrc-message", reason(r));
    } else then {
        set_text("vrc-message", "Copied. Paste it into a browser where you're logged in to vrchat.com");
    }
});

grove::get_by_id("vrc-logout").on("click", [](grove::Event&: e) -> void {
    grove::confirm("Log out", "Log Pollen out of VRChat? You'll need your password and two-factor code to log back in.", [](bool: yes) -> void {
        if (yes) then {
            call("vrc_logout", "");
            update_account();
        }
    });
});

grove::get_by_id("me-refresh").on("click", [](grove::Event&: e) -> void {
    call("vrc_refresh", "");
    set_text("me-note", "Refreshing...");
});

grove::get_by_id("act-clear").on("click", [](grove::Event&: e) -> void {
    call("vrc_activity_clear", "");
    update_activity(true);
});

grove::get_by_id("f-friends").on("change", [](grove::Event&: e) -> void {
    update_activity(true);
});

grove::get_by_id("f-joins").on("change", [](grove::Event&: e) -> void {
    update_activity(true);
});

grove::get_by_id("f-online").on("change", [](grove::Event&: e) -> void {
    update_activity(true);
});

grove::get_by_id("f-moves").on("change", [](grove::Event&: e) -> void {
    update_activity(true);
});

grove::get_by_id("f-status").on("change", [](grove::Event&: e) -> void {
    update_activity(true);
});

grove::get_by_id("fr-search").on("key_down", [](grove::Event&: e) -> void {
    friends_query = e.target().value_string();
    build_friends();
});

grove::get_by_id("fr-search").on("change", [](grove::Event&: e) -> void {
    friends_query = e.target().value_string();
    build_friends();
});

grove::get_by_id("fr-filter").on("change", [](grove::Event&: e) -> void {
    build_friends();
});

grove::get_by_id("social").on("page_show", [](grove::Event&: e) -> void {
    update_account();
    update_social();
    build_friends();
    update_activity(true);
});

grove::get_by_id("favorites").on("page_show", [](grove::Event&: e) -> void {
    update_account();
    load_favorites();
    build_favorites();
});

grove::get_by_id("fav-kind").on("change", [](grove::Event&: e) -> void {
    load_favorites();
    build_favorites();
});

grove::get_by_id("fav-refresh").on("click", [](grove::Event&: e) -> void {
    load_favorites();
});

grove::get_by_id("fav-filter").on("change", [](grove::Event&: e) -> void {
    build_favorites();
});

grove::get_by_id("fav-filter").on("key_down", [](grove::Event&: e) -> void {
    build_favorites();
});

grove::get_by_id("fav-archived").on("change", [](grove::Event&: e) -> void {
    build_favorites();
});

update_account();

grove::set_interval(1000.0, []() -> void {
    if (grove::get_by_id("settings").is_current() || grove::get_by_id("social").is_current() || grove::get_by_id("favorites").is_current()) then {
        update_account();
    }
    if (grove::get_by_id("social").is_current()) then {
        update_social();
    }
});
