body {
    --bg: #16151b;
    --panel: #1c1a22;
    --card: #221f2a;
    --raised: #2a2633;
    --line: #34303f;
    --text: #ece6f5;
    --muted: #9a92a8;
    --accent: #f7c948;
    --accent-dim: #f7c94833;
    --teal: #8bd5ca;
    --ok: #a6e3a1;
    --warn: #f9e2af;
    --bad: #f38ba8;

    size: 70vwidth 76vheight;
    min-size: 760px 520px;
    background: var(--bg);
    color: var(--text);
    accent-color: var(--accent);
    font-size: 13px;
    padding: 0;
}

page {
    flex: 1;
    gap: 0;
}

.grow {
    flex: 1;
}

.hidden {
    display: none;
}

.muted {
    color: var(--muted);
}

.mono {
    font-family: monospace;
}

.scroll {
    flex: 1;
    overflow: auto;
}

button {
    background: var(--raised);
    color: var(--text);
    border-color: var(--line);
    border-width: 1px;
    border-radius: 8px;
    padding: 6px 14px;

    &:hover {
        background: var(--line);
    }
}

button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #1b1608;
    font-weight: bold;

    &:hover {
        background: #ffd866;
    }
}

button.ghost {
    background: var(--card);
    border-color: var(--line);

    &:hover {
        background: var(--raised);
    }
}

input_string,
input_integer,
input_float,
input_select,
input_code {
    background: var(--panel);
    color: var(--text);
    border-color: var(--line);
    border-width: 1px;
    border-radius: 8px;
}

input_bool {
    appearance: switch;
}

.appbar {
    padding: 10px 16px;
    gap: 6px;
    align-items: center;
    background: var(--panel);
    border-color: var(--line);
    border-width: 0 0 1px 0;
    user-select: none;
    flex-wrap: wrap;
    row-gap: 8px;
}

.brand {
    font-size: 22px;
    font-weight: bold;
    color: var(--accent);
    margin: 0 10px 0 0;
}

.tab {
    background: var(--panel);
    border-color: var(--panel);
    color: var(--muted);

    &:hover {
        background: var(--raised);
        color: var(--text);
    }

    &:current {
        background: var(--accent-dim);
        border-color: var(--accent-dim);
        color: var(--accent);
    }
}

.version {
    margin: 0 0 0 8px;
}

.pill {
    gap: 6px;
    align-items: center;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--card);
    border-color: var(--line);
    border-width: 1px;
}

.dot {
    color: var(--muted);
}

.pill.ok .dot {
    color: var(--ok);
}

.pill.waiting .dot {
    color: var(--warn);
}

.pill.off .dot {
    color: var(--bad);
}

.page-body {
    padding: 16px;
    gap: 14px;
}

.cards {
    gap: 14px;
    flex-wrap: wrap;
    row-gap: 14px;
}

.cards > .card {
    flex: 1;
}

.card {
    min-width: 300px;
    background: var(--card);
    border-color: var(--line);
    border-width: 1px;
    border-radius: 12px;
    padding: 14px 16px;
    gap: 8px;
}

.card-head {
    align-items: center;
    gap: 8px;
}

.card-title {
    color: var(--muted);
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
}

.sub-title {
    color: var(--muted);
    font-size: 12px;
    margin: 6px 0 0 0;
}

.big {
    font-size: 20px;
    font-weight: bold;
}

.kv {
    gap: 10px;
}

.k {
    width: 110px;
    color: var(--muted);
}

.v {
    flex: 1;
}

.actions {
    gap: 8px;
    align-items: center;
    margin: 6px 0 0 0;
}

.error {
    color: var(--bad);
    white-space: pre-wrap;
}

.hint {
    color: var(--muted);
    margin: 0;
}

.stats {
    gap: 10px;
}

.stat {
    flex: 1;
    background: var(--panel);
    border-radius: 10px;
    padding: 10px 12px;
    gap: 2px;
}

.stat-num {
    font-size: 24px;
    font-weight: bold;
    color: var(--text);
}

.stat-num.small {
    font-size: 16px;
}

.stat-label {
    color: var(--muted);
    font-size: 12px;
}

.toolbar {
    padding: 10px 16px;
    gap: 12px;
    align-items: center;
    background: var(--panel);
    border-color: var(--line);
    border-width: 0 0 1px 0;
    flex-wrap: wrap;
    row-gap: 8px;
}

.toolbar.bottom {
    border-width: 1px 0 0 0;
}

.search {
    width: 260px;
}

.list {
    padding: 6px 12px;
    gap: 0;
}

.param {
    width: 100%;
    align-items: center;
    gap: 12px;
    padding: 7px 8px;
    border-color: var(--line);
    border-width: 0 0 1px 0;

    &:hover {
        background: var(--card);
    }
}

.param-name {
    flex: 1;
    min-width: 160px;
}

.param-name.unknown {
    color: var(--muted);
}

.badge {
    width: 44px;
    font-size: 11px;
    color: var(--muted);
    font-family: monospace;
}

.badge.bool {
    color: var(--teal);
}

.badge.int {
    color: #cba6f7;
}

.badge.float {
    color: var(--accent);
}

.param-control {
    width: 240px;
    align-items: center;
    gap: 8px;
}

.param-slider {
    flex: 1;
}

.param-int {
    width: 110px;
}

.param-value {
    width: 70px;
    font-family: monospace;
    color: var(--muted);
    text-align: right;
}

.readonly {
    color: var(--muted);
    font-size: 12px;
}

.empty {
    color: var(--muted);
    padding: 24px 8px;
}

.custom-name {
    width: 200px;
}

.custom-type {
    width: 90px;
}

.custom-value {
    width: 120px;
}

.compose {
    gap: 8px;
    align-items: center;
}

.chat-text {
    flex: 1;
}

.compose-meta {
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
    row-gap: 8px;
}

.template {
    height: 130px;
    font-family: monospace;
}

.placeholders {
    gap: 6px;
    flex-wrap: wrap;
    row-gap: 6px;
}

.chip {
    border-width: 1px;
    background: var(--panel);
    border-color: var(--line);
    color: var(--teal);
    border-radius: 999px;
    padding: 3px 10px;
    font-family: monospace;
    font-size: 12px;
}

.interval {
    width: 90px;
}

.preview {
    background: var(--panel);
    border-color: var(--line);
    border-width: 1px;
    border-radius: 8px;
    padding: 10px 12px;
    min-height: 40px;
    white-space: pre-wrap;
    font-family: sans-serif;
}

.log {
    padding: 8px 12px;
    gap: 0;
    scroll-anchor: bottom;
    font-family: monospace;
    font-size: 12px;
}

.log-line {
    width: 100%;
    gap: 10px;
    padding: 2px 0;
}

.log-time {
    width: 70px;
    color: var(--muted);
}

.log-dir {
    width: 18px;
}

.log-text {
    flex: 1;
    white-space: pre-wrap;
}

.log-line.i .log-dir {
    color: var(--teal);
}

.log-line.o .log-dir {
    color: var(--accent);
}

.log-line.s .log-text {
    color: var(--muted);
}

.log-line.e .log-text {
    color: var(--bad);
}

.raw {
    flex: 1;
}

#raw-error {
    padding: 0 16px 10px 16px;
}

.field {
    gap: 12px;
    align-items: center;
}

.label {
    width: 140px;
    color: var(--muted);
}

.wide {
    width: 260px;
}

.folders {
    gap: 4px;
    font-family: monospace;
    font-size: 12px;
}

.scene {
    height: 170px;
    align: center;
    gap: 8px;
    border-radius: 10px;
    background: #24303d;
    border-color: var(--line);
    border-width: 1px;
}

.bubble {
    max-width: 360px;
    background: rgba(18, 20, 26, 90%);
    border-color: rgba(255, 255, 255, 12%);
    border-width: 1px;
    border-radius: 16px;
    padding: 10px 18px;
}

.bubble-text {
    color: #ffffff;
    font-size: 16px;
    text-align: center;
    white-space: pre-wrap;
}

.bubble-empty {
    color: #8794a3;
    font-style: italic;
}

.typing {
    gap: 5px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(18, 20, 26, 90%);
}

.tdot {
    color: #ffffff;
    font-size: 10px;
}

.nameplate {
    display: inline-block;
    margin: 6px 0 0 0;
    background: rgba(0, 0, 0, 55%);
    color: #ffffff;
    border-radius: 999px;
    padding: 3px 14px;
    font-size: 12px;
}

.modules-hint {
    font-size: 14px;
    margin: 4px 4px 8px 4px;
}

.module-grid {
    gap: 24px;
    row-gap: 24px;
    flex-wrap: wrap;
    padding: 4px 4px 24px 4px;
}

.module-card {
    flex: 1;
    min-width: 330px;
    max-width: 560px;
    min-height: 220px;
    background: var(--card);
    border-color: var(--line);
    border-width: 1px;
    border-radius: 16px;
    padding: 22px 24px;
    gap: 12px;
    cursor: pointer;
    user-select: none;

    &:hover {
        background: var(--raised);
        border-color: var(--accent);
    }
}

.module-head {
    gap: 12px;
    align-items: center;
}

.module-icon {
    color: var(--accent);
    font-size: 28px;
}

.module-title {
    font-size: 21px;
    font-weight: bold;
}

.module-desc {
    color: var(--muted);
    font-size: 14px;
}

.module-sample {
    flex: 1;
    background: var(--panel);
    border-radius: 10px;
    padding: 12px 14px;
    white-space: pre-wrap;
    font-size: 15px;
}

.module-count {
    color: var(--teal);
    font-size: 13px;
}

#module-modal {
    width: 980px;
    max-width: 94vwidth;
    background: var(--card);
    border-color: var(--line);
    border-width: 1px;
    border-radius: 14px;
    padding: 0;
}

.modal-head {
    gap: 12px;
    align-items: center;
    padding: 14px 18px;
    border-color: var(--line);
    border-width: 0 0 1px 0;
}

.mm-icon {
    font-size: 26px;
    color: var(--accent);
}

.modal-body {
    max-height: 74vheight;
    overflow: auto;
    padding: 12px 18px 16px 18px;
    gap: 8px;
}

.mm-options {
    gap: 8px;
}

.mm-options > input_bool {
    margin: 3px 0;
}

.modal-body > .sub-title {
    margin: 10px 0 2px 0;
    font-weight: bold;
}

.mm-option {
    gap: 12px;
    align-items: center;
}

.mm-label {
    width: 220px;
    color: var(--text);
}

.mm-hint {
    color: var(--muted);
    font-size: 11px;
    margin: -2px 0 4px 0;
}

.mm-input {
    width: 240px;
}

.mm-template {
    height: 90px;
    font-family: monospace;
}

.mm-status {
    color: var(--muted);
    font-size: 12px;
}

.chip {
    cursor: pointer;

    &:hover {
        border-color: var(--teal);
    }
}

.chip.off {
    color: #5f5a6b;
    border-color: var(--panel);
    text-decoration: line-through;
}

.ph-list {
    gap: 0;
    background: var(--panel);
    border-color: var(--line);
    border-width: 1px;
    border-radius: 10px;
    padding: 4px 0;
}

.status-ph {
    max-height: 260px;
    overflow: auto;
}

.ph-row {
    gap: 6px;
    padding: 9px 14px;
    border-color: var(--line);
    border-width: 0 0 1px 0;
}

.ph-head {
    gap: 14px;
    align-items: center;
}

.ph-chip {
    width: 190px;
    align-items: start;
}

.ph-desc {
    flex: 1;
    color: var(--text);
    font-size: 13px;
}

.ph-row.off .ph-desc {
    color: var(--muted);
}

.ph-need {
    color: var(--warn);
    font-size: 12px;
    margin: 0 0 0 204px;
}

.ph-settings {
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
    row-gap: 6px;
    margin: 0 0 0 204px;
}

.ph-setting {
    gap: 8px;
    align-items: center;
}

.ph-label {
    color: var(--muted);
    font-size: 12px;
}

.ph-select {
    width: 250px;
}

.warning {
    background: #3a2f12;
    border-color: #f9e2af55;
    border-width: 1px;
    border-radius: 8px;
    padding: 8px 12px;
    color: var(--warn);
    font-size: 12px;
    white-space: pre-wrap;
}

.small-note {
    font-size: 12px;
}

.me-row {
    gap: 12px;
    align-items: center;
}

.status-dot {
    font-size: 26px;
    color: var(--muted);
}

.status-dot.s-join {
    color: #59a6ff;
}

.status-dot.s-active {
    color: #5fd068;
}

.status-dot.s-ask {
    color: #ff9d3b;
}

.status-dot.s-busy {
    color: #f05454;
}

.status-dot.s-offline {
    color: #6b6577;
}

button.small {
    padding: 3px 10px;
    font-size: 12px;
}

.social-half {
    min-height: 300px;
}

.filters {
    gap: 14px;
    row-gap: 6px;
    flex-wrap: wrap;
    font-size: 12px;
}

.activity {
    max-height: 340px;
    overflow: auto;
    scroll-anchor: bottom;
    gap: 0;
    background: var(--panel);
    border-radius: 8px;
    padding: 6px 10px;
}

.act-line {
    gap: 10px;
    padding: 3px 0;
}

.act-time {
    width: 72px;
    color: var(--muted);
    font-size: 12px;
}

.act-text {
    flex: 1;
}

.act-line.friend .act-text {
    color: var(--teal);
}

.act-line.removed .act-text {
    color: var(--bad);
}

.act-line.world .act-text {
    color: var(--accent);
}

.people {
    gap: 0;
}

.person {
    gap: 12px;
    align-items: center;
    padding: 8px 6px;
    border-color: var(--line);
    border-width: 0 0 1px 0;

    &:hover {
        background: var(--raised);
    }
}

.person-dot {
    width: 18px;
    font-size: 15px;
    color: var(--muted);
}

.person-dot.s-join {
    color: #59a6ff;
}

.person-dot.s-active {
    color: #5fd068;
}

.person-dot.s-ask {
    color: #ff9d3b;
}

.person-dot.s-busy {
    color: #f05454;
}

.person-main {
    flex: 1;
    gap: 2px;
}

.person-name {
    font-weight: bold;
}

.person-name.friend {
    color: var(--teal);
}

.person-sub {
    color: var(--muted);
    font-size: 12px;
}

.person-actions {
    gap: 6px;
    align-items: center;
}

.empty-small {
    color: var(--muted);
    padding: 10px 4px;
}

.device-code {
    font-size: 34px;
    font-weight: bold;
    font-family: monospace;
    letter-spacing: 4px;
    color: var(--accent);
}

.vrc-box {
    gap: 8px;
    margin: 6px 0 0 0;
}

.fav-row {
    width: 100%;
    align-items: center;
    gap: 14px;
    padding: 9px 8px;
    border-color: var(--line);
    border-width: 0 0 1px 0;

    &:hover {
        background: var(--card);
    }
}

.fav-main {
    flex: 1;
    gap: 2px;
}

.fav-name {
    font-weight: bold;
}

.fav-detail {
    color: var(--muted);
    font-size: 12px;
}

.fav-group {
    width: 170px;
    color: var(--teal);
    font-size: 12px;
}

.fav-move {
    width: 190px;
}

.fav-row.archived .fav-name {
    color: var(--muted);
}

.ph-examples {
    gap: 6px;
    row-gap: 4px;
    flex-wrap: wrap;
    align-items: center;
    margin: 0 0 0 204px;
}

.small-chip {
    font-size: 11px;
    padding: 2px 8px;
    color: var(--muted);
}
