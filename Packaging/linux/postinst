#!/bin/sh
set -e
mkdir -p /usr/bin /usr/share/applications /usr/share/icons/hicolor/scalable/apps /usr/share/icons/hicolor/512x512/apps
for exe in pollen; do
    ln -sf /opt/pollen/$exe /usr/bin/$exe
done
ln -sf /opt/pollen/share/applications/pollen.desktop /usr/share/applications/pollen.desktop
ln -sf /opt/pollen/share/icons/hicolor/scalable/apps/pollen.svg /usr/share/icons/hicolor/scalable/apps/pollen.svg
ln -sf /opt/pollen/share/icons/hicolor/512x512/apps/pollen.png /usr/share/icons/hicolor/512x512/apps/pollen.png
if command -v update-desktop-database > /dev/null 2>&1; then update-desktop-database -q /usr/share/applications || true; fi
if command -v gtk-update-icon-cache > /dev/null 2>&1; then gtk-update-icon-cache -q -t /usr/share/icons/hicolor || true; fi
exit 0
