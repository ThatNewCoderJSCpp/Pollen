if(APPLE)
    set(POLLEN_PACKAGE_GENERATORS "TGZ;TXZ;ZIP" CACHE STRING "Package formats cpack produces")
else()
    set(POLLEN_PACKAGE_GENERATORS "TGZ;TXZ;ZIP;DEB;RPM" CACHE STRING "Package formats cpack produces")
endif()
set(CPACK_GENERATOR ${POLLEN_PACKAGE_GENERATORS})
set(CPACK_PACKAGE_CONTACT "ThatNewCoderJSCpp <https://github.com/ThatNewCoderJSCpp/Pollen>")
set(CPACK_PACKAGE_HOMEPAGE_URL "https://github.com/ThatNewCoderJSCpp/Pollen")
set(CPACK_PACKAGE_DIRECTORY "${CMAKE_BINARY_DIR}")
set(CPACK_PROJECT_CONFIG_FILE "${CMAKE_CURRENT_LIST_DIR}/PollenCPackOptions.cmake")

if(NOT APPLE)
    set(_pollen_pkg "${CMAKE_CURRENT_SOURCE_DIR}/Packaging")
    install(FILES "${_pollen_pkg}/linux/pollen.desktop" DESTINATION share/applications COMPONENT pollen)
    install(FILES "${_pollen_pkg}/icons/pollen.svg" DESTINATION share/icons/hicolor/scalable/apps COMPONENT pollen)
    install(FILES "${_pollen_pkg}/icons/pollen-512.png" DESTINATION share/icons/hicolor/512x512/apps RENAME pollen.png COMPONENT pollen)

    set(_pollen_scripts "${CMAKE_BINARY_DIR}/package-scripts")
    file(MAKE_DIRECTORY "${_pollen_scripts}")
    file(COPY "${_pollen_pkg}/linux/postinst" "${_pollen_pkg}/linux/prerm" DESTINATION "${_pollen_scripts}"
        FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)

    set(CPACK_DEBIAN_PACKAGE_NAME pollen)
    set(CPACK_DEBIAN_FILE_NAME ${CPACK_PACKAGE_FILE_NAME}.deb)
    set(CPACK_DEBIAN_PACKAGE_SECTION utils)
    set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
    set(CPACK_DEBIAN_PACKAGE_CONTROL_EXTRA "${_pollen_scripts}/postinst;${_pollen_scripts}/prerm")

    set(CPACK_RPM_PACKAGE_NAME pollen)
    set(CPACK_RPM_FILE_NAME ${CPACK_PACKAGE_FILE_NAME}.rpm)
    set(CPACK_RPM_PACKAGE_GROUP "Applications/Internet")
    set(CPACK_RPM_PACKAGE_LICENSE "See https://github.com/ThatNewCoderJSCpp/Pollen")
    set(CPACK_RPM_PACKAGE_URL "https://github.com/ThatNewCoderJSCpp/Pollen")
    set(CPACK_RPM_PACKAGE_AUTOREQ ON)
    set(CPACK_RPM_PACKAGE_AUTOPROV OFF)
    set(CPACK_RPM_SPEC_MORE_DEFINE "%define _build_id_links none\n%define debug_package %{nil}\n%define __os_install_post %{nil}")
    set(CPACK_RPM_EXCLUDE_FROM_AUTO_FILELIST_ADDITION /opt)
    set(CPACK_RPM_POST_INSTALL_SCRIPT_FILE "${_pollen_scripts}/postinst")
    set(CPACK_RPM_PRE_UNINSTALL_SCRIPT_FILE "${_pollen_scripts}/prerm")

    if(_pollen_arch STREQUAL "arm64")
        set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE arm64)
        set(CPACK_RPM_PACKAGE_ARCHITECTURE aarch64)
    elseif(_pollen_arch STREQUAL "i686")
        set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE i386)
        set(CPACK_RPM_PACKAGE_ARCHITECTURE i686)
    elseif(_pollen_arch STREQUAL "x86_64")
        set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE amd64)
        set(CPACK_RPM_PACKAGE_ARCHITECTURE x86_64)
    endif()
endif()
